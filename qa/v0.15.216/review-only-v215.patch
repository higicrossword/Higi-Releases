diff --git a/app/src/main/java/com/example/hebrewcrossword/OcrMaarivOdedLayoutV216.kt b/app/src/main/java/com/example/hebrewcrossword/OcrMaarivOdedLayoutV216.kt
new file mode 100644
index 0000000..83d747b
--- /dev/null
+++ b/app/src/main/java/com/example/hebrewcrossword/OcrMaarivOdedLayoutV216.kt
@@ -0,0 +1,168 @@
+package com.example.hebrewcrossword
+
+import kotlin.math.ceil
+import kotlin.math.max
+
+/**
+ * MAARIV_ODED_ROZEN-specific, administrator REVIEW_ONLY source layout.
+ *
+ * Proven by two independent printed images with the same 11x11 block mask and
+ * numbering. This is NOT a general rule for 'Maariv' and not a date-specific rule.
+ * It is guarded by exact series identity, exact grid topology and realistic
+ * image-space bounds. No candidate can modify a clue or Canonical data.
+ */
+object OcrMaarivOdedLayoutV216 {
+    const val SERIES_ID = "MAARIV_ODED_ROZEN"
+    val BLOCK_ROWS = listOf(
+        ".....#.....",
+        ".#.#.#.#.#.",
+        ".......#...",
+        ".#.#.###.#.",
+        "...#.......",
+        "####.#.#.##",
+        "....#......",
+        ".#.#.#.###.",
+        "........#..",
+        ".#.#.#.#.#.",
+        ".....##...."
+    )
+    val BLOCK_MASK = BLOCK_ROWS.joinToString("")
+    data class Plan(val startY: Int, val reason: String = "MAARIV_ODED_11X11_CLUES_BELOW_GRID")
+
+    /** Never route a generic Maariv/guest puzzle into this profile. */
+    fun exactSeries(sourceKey: String, title: String): Boolean {
+        val explicit = sourceKey.substringBefore(':')
+        if (explicit == SERIES_ID) return true
+        if (explicit in setOf("TARTEY_DEKEL", "HAFUCH_DEKEL", "YEDIOTH_DEKEL_WEEKLY",
+                "YEDIOTH_MONDAY_DEKEL", "YEDIOTH_WEDNESDAY_DEKEL",
+                "MAKOR_RISHON", "LAISHA_DEKEL", "MAARIV_GUEST", "GUEST_AVISHAI",
+                "BARUCH_LIOR", "TZAFNAT_PAANEACH", "ISRAEL_HAYOM_BIRMAN")) return false
+        // Some catalog entries expose only a human-readable series title.
+        return "מעריב" in title && "עודד" in title && "רוזן" in title && "אורח" !in title
+    }
+
+    fun matches(rows: Int, cols: Int, blockedMask: String): Boolean =
+        rows == 11 && cols == 11 && blockedMask == BLOCK_MASK
+
+    /** A source-image crop, not a screen or zoom crop. No hardcoded pixel values. */
+    fun plan(
+        sourceKey: String, title: String, rows: Int, cols: Int, blockedMask: String,
+        imageWidth: Int, imageHeight: Int,
+        gridLeft: Float, gridTop: Float, gridRight: Float, gridBottom: Float
+    ): Plan? {
+        if (!exactSeries(sourceKey, title) || !matches(rows, cols, blockedMask)) return null
+        if (imageWidth < 650 || imageHeight < 900) return null
+        val width = gridRight - gridLeft
+        val height = gridBottom - gridTop
+        if (!width.isFinite() || !height.isFinite() || width <= 0 || height <= 0) return null
+        // Reject a partial grid, a misplaced grid, and a page with no clue area.
+        if (gridLeft < -1 || gridRight > imageWidth + 1 || gridTop < 0 || gridBottom >= imageHeight) return null
+        if (width / imageWidth !in 0.70f..0.98f ||
+            height / imageHeight !in 0.38f..0.76f ||
+            width / height !in .86f..1.15f ||
+            gridTop / imageHeight !in 0.025f..0.20f ||
+            gridBottom / imageHeight !in 0.49f..0.76f ||
+            imageHeight - gridBottom < imageHeight * .22f) return null
+        // Start just below the bottom border. The two text sections remain in
+        // source order; the Tesseract pass no longer has to interpret the grid.
+        val start = ceil(gridBottom + max(5f, height * .014f)).toInt()
+        if (start !in 0 until imageHeight || imageHeight - start < imageHeight / 5) return null
+        return Plan(start)
+    }
+}
+
+/** Read-only, per-clue fail-closed extraction from the selected clue band.
+ *
+ * OCR text is in logical Hebrew reading order; its tuples MUST NOT be treated
+ * as physical left-to-right pixel observations and MUST NOT be used to rewrite
+ * Higi's authoritative printedParts/typingParts conversions.
+ */
+object OcrMaarivOdedCluesV216 {
+    data class Audit(
+        val candidates: Map<AdminLocalOcrLengthV213.Key, List<Int>>,
+        val perClue: Map<AdminLocalOcrLengthV213.Key, String>,
+        val reason: String,
+        val stats: String
+    )
+    private val headingH = Regex("(?m)^[ \\t]*[:：]?[ \\t]*מאוזן[ \\t]*[:：]?")
+    private val headingV = Regex("(?m)^[ \\t]*[:：]?[ \\t]*מאונך[ \\t]*[:：]?")
+    private val marker = Regex("(?<![0-9])([0-9]{1,2})[ \\t]*[.:]")
+    private val tuple = Regex("\\(\\s*([0-9]{1,2}(?:\\s*[,;.]\\s*[0-9]{1,2}){1,5})\\s*\\)")
+    private val number = Regex("[0-9]{1,2}")
+    private val crossReference = Regex("[0-9]{1,2}\\s*(מאוזן|מאונך)")
+    private val bidiControls = Regex("[\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]")
+    private data class Marker(val number: Int, val range: IntRange)
+
+    fun inspect(raw: String, h: Map<Int, Int>, v: Map<Int, Int>): Audit {
+        // Keep line breaks: the headings are paragraph starts, not incidental
+        // words in the text of "with 17 across" cross-references.
+        val text = raw.replace(bidiControls, "")
+        val states = linkedMapOf<AdminLocalOcrLengthV213.Key, String>()
+        for (n in h.keys) states[AdminLocalOcrLengthV213.Key("across", n)] = "number-not-seen"
+        for (n in v.keys) states[AdminLocalOcrLengthV213.Key("down", n)] = "number-not-seen"
+        val results = linkedMapOf<AdminLocalOcrLengthV213.Key, List<Int>>()
+        val horiz = headingH.find(text)
+        val vert = horiz?.let { headingV.find(text, it.range.last + 1) }
+        var labels = 0
+        var unknown = 0
+        var unordered = 0
+        var ambiguities = 0
+        var mismatches = 0
+        var safe = 0
+
+        fun scan(section: String, dir: String, expected: Map<Int, Int>) {
+            // ALL markers delimit a candidate; a misread 11 as "1." must not
+            // contaminate the adjacent number 9 or silently become 11.
+            val tokens = marker.findAll(section).mapNotNull { m ->
+                m.groupValues[1].toIntOrNull()?.let { Marker(it, m.range) }
+            }.toList()
+            val counts = tokens.filter { it.number in expected }.groupingBy { it.number }.eachCount()
+            var last = 0
+            tokens.forEachIndexed { i, item ->
+                val n = item.number
+                if (n !in expected) { unknown++; return@forEachIndexed }
+                val key = AdminLocalOcrLengthV213.Key(dir, n)
+                if ((counts[n] ?: 0) != 1) { states[key] = "duplicate-number-anchor"; ambiguities++; return@forEachIndexed }
+                if (n <= last) { states[key] = "number-order-conflict"; unordered++; return@forEachIndexed }
+                last = n
+                labels++
+                val end = tokens.getOrNull(i + 1)?.range?.first ?: section.length
+                val clue = section.substring(item.range.last + 1, end)
+                val brackets = tuple.findAll(clue).toList()
+                if (brackets.size != 1) {
+                    states[key] = if (brackets.isEmpty()) "no-multipart-tuple" else "ambiguous-multiple-tuples"
+                    if (brackets.size > 1) ambiguities++
+                    return@forEachIndexed
+                }
+                val parts = number.findAll(brackets.single().groupValues[1]).map { it.value.toInt() }.toList()
+                val sum = parts.sum()
+                val grid = expected[n] ?: 0
+                val referred = crossReference.containsMatchIn(clue)
+                if (parts.size !in 2..6 || parts.any { it !in 1..99 } ||
+                    !(sum == grid || (referred && sum > grid && grid > 0))) {
+                    states[key] = "tuple-grid-or-reference-mismatch"
+                    mismatches++
+                    return@forEachIndexed
+                }
+                results[key] = parts  // OCR logical word order, unverified.
+                states[key] = "source-clue-ocr-observed-unverified"
+                safe++
+            }
+        }
+        if (horiz != null && vert != null && vert.range.first > horiz.range.last) {
+            scan(text.substring(horiz.range.last + 1, vert.range.first), "across", h)
+            scan(text.substring(vert.range.last + 1), "down", v)
+        }
+        val reason = when {
+            horiz == null -> "missing-across-heading-in-cropped-text"
+            vert == null -> "missing-down-heading-in-cropped-text"
+            results.isEmpty() -> "no-safe-observations-after-heading-recovery"
+            else -> "series-template-readonly-observations"
+        }
+        val stats = "profile=MAARIV_ODED_V216;headingH=${if (horiz != null) 1 else 0};" +
+            "headingV=${if (vert != null) 1 else 0};labels=$labels;unknown=$unknown;" +
+            "unordered=$unordered;ambiguous=$ambiguities;gridMismatch=$mismatches;" +
+            "observed=$safe;authority=none"
+        return Audit(results, states, reason, stats)
+    }
+}
