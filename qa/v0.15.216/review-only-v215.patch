+package com.example.hebrewcrossword
+
+/** Synthetic OCR strings only; no copyrighted crossword clue text in fixtures. */
+fun main() {
+    var checks = 0
+    fun must(value:Boolean, reason:String) { check(value) { reason }; checks++ }
+    val layout = OcrMaarivOdedLayoutV216
+    val mask = layout.BLOCK_MASK
+    must(layout.BLOCK_ROWS.size==11 && layout.BLOCK_ROWS.all{it.length==11}, "11x11 mask")
+    must(mask.length==121, "full mask")
+    must(layout.matches(11,11,mask), "template exact match")
+    must(!layout.matches(11,11,mask.replaceFirst('#','.')), "blocked-cell mismatch")
+    must(!layout.matches(11,10,mask) && !layout.matches(10,11,mask), "dimensions mismatch")
+    must(layout.exactSeries("MAARIV_ODED_ROZEN:20261120",""), "exact stable source key")
+    must(layout.exactSeries("","מעריב – עודד רוזן"), "explicit two-name fallback")
+    must(!layout.exactSeries("","מעריב אורח"), "no guest")
+    must(!layout.exactSeries("","מעריב"), "not generic Maariv")
+    must(!layout.exactSeries("YEDIOTH_DEKEL_WEEKLY:x","דקל בנו שני"), "no Dekel")
+    must(!layout.exactSeries("HAFUCH_DEKEL:x","הפוך על הפוך"), "no Hafuch")
+    must(!layout.exactSeries("HAFUCH_DEKEL:20261123","מעריב – עודד רוזן"),
+        "explicit other series outranks conflicting title")
+    fun plan(w:Int,h:Int,left:Float,top:Float,right:Float,bottom:Float)=layout.plan(
+        "MAARIV_ODED_ROZEN:20261120","",11,11,mask,w,h,left,top,right,bottom)
+    val a=plan(1000,1581,22f,110f,949f,1029f)
+    val b=plan(1039,1536,38f,91f,969f,987f)
+    must(a!=null && b!=null, "both verified reference photographs")
+    must(a!!.startY>1029 && b!!.startY>987, "crop begins below bottom border")
+    must(a.startY<1100 && b!!.startY<1070, "not cutting first clue line")
+    must(layout.plan("HAFUCH_DEKEL", "",11,11,mask,1000,1581,22f,110f,949f,1029f)==null,
+        "wrong source series blocked")
+    must(layout.plan("MAARIV_ODED_ROZEN", "",11,11,mask.replaceFirst('#','.'),
+        1000,1581,22f,110f,949f,1029f)==null, "false identity blocks layout")
+    must(plan(1000,1581,22f,110f,949f,1540f)==null, "missing clue zone")
+    must(plan(1000,1581,22f,110f,500f,1029f)==null, "partial grid")
+    must(plan(1000,1581,-150f,110f,949f,1029f)==null, "off-image grid")
+
+    val h = mapOf(1 to 5,4 to 5,7 to 3,8 to 7,9 to 7,11 to 3,12 to 6,
+        13 to 4,17 to 2,18 to 8,20 to 4,21 to 5)
+    val v = mapOf(1 to 5,2 to 7,3 to 3,4 to 6,5 to 5,6 to 5,10 to 6,
+        12 to 5,14 to 5,15 to 5,16 to 4,19 to 2)
+    fun key(d:String,n:Int)=AdminLocalOcrLengthV213.Key(d,n)
+    val text="""
+        מאוזן: 1. הגדרה (5) 4. הגדרה (3,2)
+        7. (עם 17 מאוזן) הגדרה (3,2) 8. הגדרה (7)
+        9. הגדרה (7) 11. (עם 19 מאונך) הגדרה (3,2)
+        12. הגדרה (6) 13. הגדרה (4) 17. ר' 7 מאוזן
+        18. הגדרה (3,5) 20. הגדרה (4) 21. הגדרה (5)
+        מאונך: 1. הגדרה (5) 2. הגדרה (7)
+        3. הגדרה (3) 4. הגדרה (6) 5. הגדרה (5)
+        6. הגדרה (5) 10. הגדרה (6) 12. הגדרה (5)
+        14. הגדרה (5) 15. הגדרה (3,2)
+        16. הגדרה (4) 19. (עם 17 מאוזן) הגדרה (2,2)
+    """.trimIndent()
+    val first=OcrMaarivOdedCluesV216.inspect(text,h,v)
+    must(first.reason=="series-template-readonly-observations", "accepted diagnostic")
+    must(first.candidates[key("across",4)]==listOf(3,2), "H4 OCR logical order")
+    must(first.candidates[key("across",7)]==listOf(3,2), "H7 reference sum exceeds own grid")
+    must(first.candidates[key("across",11)]==listOf(3,2), "H11 reference")
+    must(first.candidates[key("across",18)]==listOf(3,5), "H18 no auto-reversal")
+    must(first.candidates[key("down",15)]==listOf(3,2), "V15")
+    must(first.candidates[key("down",19)]==listOf(2,2), "V19 reference")
+    must(key("across",17) !in first.candidates, "pure reference has no own length")
+    must(first.perClue[key("across",17)]=="no-multipart-tuple", "reference explained")
+    // Old strict parser rejects a whole section when 11 is misread as 1;
+    // v216 must instead skip that anchor while retaining the unambiguous H18.
+    val noisy=text.replace(" 11. (עם", " 1. (עם")
+    val degraded=OcrMaarivOdedCluesV216.inspect(noisy,h,v)
+    must(degraded.candidates[key("across",18)]==listOf(3,5), "H18 survives 11->1 OCR misread")
+    must(degraded.candidates[key("across",4)]==listOf(3,2), "H4 survives unrelated OCR misread")
+    must(key("across",11) !in degraded.candidates, "no invented 11")
+    must(key("across",1) !in degraded.candidates, "duplicated 1 is not trusted")
+    must(degraded.perClue[key("across",1)]=="duplicate-number-anchor", "duplicate status")
+    val missingColon=OcrMaarivOdedCluesV216.inspect(text.replace("מאוזן:","מאוזן").replace("מאונך:","מאונך"),h,v)
+    must(missingColon.candidates[key("across",18)]==listOf(3,5), "no colon supported")
+    val beforeColon=OcrMaarivOdedCluesV216.inspect(text.replace("מאוזן:",":מאוזן").replace("מאונך:",":מאונך"),h,v)
+    must(beforeColon.candidates[key("across",18)]==listOf(3,5), "reversed colon supported")
+    must(OcrMaarivOdedCluesV216.inspect("1. (עם 17 מאוזן) (3,2)\n19. (עם 11 מאונך) (2,2)",h,v)
+        .candidates.isEmpty(), "references are not section headings")
+    val ambiguous=OcrMaarivOdedCluesV216.inspect(text.replace("18. הגדרה (3,5)","18. הגדרה (3,5) (5,3)"),h,v)
+    must(key("across",18) !in ambiguous.candidates, "multiple tuples rejected")
+    val invalidSum=OcrMaarivOdedCluesV216.inspect(text.replace("18. הגדרה (3,5)","18. הגדרה (2,5)"),h,v)
+    must(key("across",18) !in invalidSum.candidates, "wrong grid sum rejected")
+    val swapped=OcrMaarivOdedCluesV216.inspect(text.substringAfter("מאונך:").prependIndent("מאונך: ")+"\n"+
+        text.substringBefore("מאונך:").prependIndent("מאוזן: "),h,v)
+    must(swapped.candidates.isEmpty(), "wrong paragraph order rejected")
+    println("V216_MAARIV_ODED_LAYOUT_QA_PASS assertions=$checks")
+}
