diff --git a/app/src/main/java/com/example/hebrewcrossword/AdminAiTimeBudgetV218.kt b/app/src/main/java/com/example/hebrewcrossword/AdminAiTimeBudgetV218.kt
new file mode 100644
index 0000000..3c7a0b2
--- /dev/null
+++ b/app/src/main/java/com/example/hebrewcrossword/AdminAiTimeBudgetV218.kt
@@ -0,0 +1,34 @@
+package com.example.hebrewcrossword
+
+/** Pure, fail-closed administrator diagnostic time budget.
+ * It does not change normal OCR, Gemini settings, retries, or decoding.
+ */
+object AdminAiTimeBudgetV218 {
+    const val SINGLE_PROBE_MS=110_000L
+    const val RUN_LIMIT_MS=330_000L
+
+    fun deadline(startedElapsedMs:Long):Long =
+        if(startedElapsedMs > Long.MAX_VALUE-RUN_LIMIT_MS) Long.MAX_VALUE
+        else startedElapsedMs+RUN_LIMIT_MS
+
+    /** Zero means do not start a new paid request. */
+    fun probeBudget(deadlineElapsedMs:Long,nowElapsedMs:Long):Long =
+        (deadlineElapsedMs-nowElapsedMs).coerceAtLeast(0L).coerceAtMost(SINGLE_PROBE_MS)
+
+    fun failureCategory(error:Throwable):String {
+        val chain=generateSequence(error){it.cause}.take(8).toList()
+        val names=chain.map{it.javaClass.simpleName}
+        val msg=chain.joinToString(" "){it.message.orEmpty()}.lowercase()
+        return when {
+            "TimeoutCancellationException" in names -> "admin-probe-deadline"
+            "AiAttemptTimeoutException" in names -> "sdk-attempt-timeout"
+            "admin-run-deadline-exceeded" in msg -> "admin-run-deadline"
+            "UnknownHostException" in names || "ConnectException" in names || "SocketException" in names -> "network-error"
+            "CancellationException" in names -> "cancelled"
+            "429" in msg || "resource_exhausted" in msg -> "provider-rate-limit"
+            "503" in msg || "unavailable" in msg -> "provider-unavailable"
+            "app check" in msg || "appcheck" in msg -> "app-check-error"
+            else -> "other-error"
+        }
+    }
+}
