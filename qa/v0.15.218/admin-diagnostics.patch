+package com.example.hebrewcrossword
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AdminAiTimeBudgetV218JUnitTest {
+    @Test fun boundedAtStartAndEnd() {
+        val d=AdminAiTimeBudgetV218.deadline(1_000L)
+        assertEquals(331_000L,d)
+        assertEquals(110_000L,AdminAiTimeBudgetV218.probeBudget(d,1_000L))
+        assertEquals(1L,AdminAiTimeBudgetV218.probeBudget(d,330_999L))
+        assertEquals(0L,AdminAiTimeBudgetV218.probeBudget(d,331_000L))
+        assertEquals(0L,AdminAiTimeBudgetV218.probeBudget(d,331_001L))
+    }
+
+    @Test fun exhaustionAndOverflow() {
+        assertEquals(Long.MAX_VALUE,AdminAiTimeBudgetV218.deadline(Long.MAX_VALUE))
+        assertEquals(0L,AdminAiTimeBudgetV218.probeBudget(4L,8L))
+    }
+
+    @Test fun errorCategorizationDoesNotRevealTokens() {
+        assertEquals("admin-run-deadline",AdminAiTimeBudgetV218.failureCategory(
+            IllegalStateException("admin-run-deadline-exceeded")))
+        assertEquals("provider-rate-limit",AdminAiTimeBudgetV218.failureCategory(
+            IllegalStateException("HTTP 429 secret-123")))
+        assertEquals("network-error",AdminAiTimeBudgetV218.failureCategory(
+            java.net.UnknownHostException("secret-host")))
+    }
