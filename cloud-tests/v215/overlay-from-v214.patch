--- /dev/null
+++ b/tools/tests/AdminLocalOcrGateDiagnosticsV215Test.kt
@@ -0,0 +1,48 @@
+package com.example.hebrewcrossword
+
+/** v215 is a pure observer: it must never change what v213 extracts. */
+fun main() {
+    var assertions=0
+    val h=mapOf(4 to 5,7 to 5,11 to 5,18 to 8)
+    val v=mapOf(1 to 5,2 to 4)
+    fun checkCase(name:String,raw:String,expectedReason:String,expectedKey:String?=null,
+                  expectedAcross:Int?=null) {
+        val a=AdminLocalOcrGateDiagnosticsV215.inspect(raw,h,v,17)
+        val old=AdminLocalOcrLengthV213.extract(raw,h,v)
+        check(a.candidates==old) { "candidate regression $name" }; assertions++
+        check(a.reason==expectedReason) { "$name reason=${a.reason} expected=$expectedReason stats=${a.stats}" }; assertions++
+        check(a.stats.contains("lines=17;")) { "missing counters $name" }; assertions++
+        if(expectedKey!=null) {
+            check(a.perClue[AdminLocalOcrLengthV213.Key("across",4)]==expectedKey) {
+                "$name clue=${a.perClue[AdminLocalOcrLengthV213.Key("across",4)]}" }; assertions++
+        }
+        if(expectedAcross!=null) {
+            check(a.candidates[AdminLocalOcrLengthV213.Key("across",4)]?.sum()==expectedAcross) {name}; assertions++
+        }
+        // Source OCR/clue prose must never appear in diagnostics.
+        check(!a.stats.contains("secret") && !a.reason.contains("secret") &&
+            a.perClue.values.none { it.contains("secret") }) { "OCR text leak $name" }; assertions++
+    }
+    val base="מאוזן: 4. secret (3,2) 7. other (3,2) 11. other (3,2) 18. other (5,3) מאונך: 1. one (5) 2. two (4)"
+    checkCase("valid baseline",base,"candidates-present","accepted",5)
+    checkCase("missing H heading",base.replace("מאוזן:","אופקי"),"missing-horizontal-heading","section-header-unavailable")
+    checkCase("colonless H heading",base.replace("מאוזן:","מאוזן"),"missing-horizontal-heading","section-header-unavailable")
+    checkCase("missing V heading",base.replace("מאונך:","אנכי"),"missing-vertical-heading","section-header-unavailable")
