diff --git a/app/src/main/java/com/example/hebrewcrossword/AdminLocalOcrGateDiagnosticsV215.kt b/app/src/main/java/com/example/hebrewcrossword/AdminLocalOcrGateDiagnosticsV215.kt
new file mode 100644
index 0000000..57ef707
--- /dev/null
+++ b/app/src/main/java/com/example/hebrewcrossword/AdminLocalOcrGateDiagnosticsV215.kt
@@ -0,0 +1,160 @@
+package com.example.hebrewcrossword
+
+/** Administrator-only, non-authoritative diagnostics for an EXISTING OCR parser.
+ *
+ * All candidates come from AdminLocalOcrLengthV213.extract(), unchanged.
+ * The side-channel reports which strict gates stopped an observation. It does
+ * not alter word order, candidate selection, puzzle state or any OCR profile.
+ * No recognized text is retained or logged; only counts and bounded statuses.
+ */
+object AdminLocalOcrGateDiagnosticsV215 {
+    data class Audit(
+        val candidates: Map<AdminLocalOcrLengthV213.Key, List<Int>>,
+        val reason: String,
+        val stats: String,
+        val perClue: Map<AdminLocalOcrLengthV213.Key, String>
+    )
+    private val strictAcross = Regex("מאוזן\\s*:")
+    private val strictDown = Regex("מאונך\\s*:")
+    private val bareAcross = Regex("מאוזן")
+    private val bareDown = Regex("מאונך")
+    private val marker = Regex("(?<![0-9])([0-9]{1,3})\\s*\\.")
+    private val tuple = Regex("\\(\\s*([0-9]{1,2}(?:\\s*[,;.]\\s*[0-9]{1,2}){1,5})\\s*\\)")
+    private val part = Regex("[0-9]{1,2}")
+    private val explicitReference = Regex("[0-9]{1,3}\\s*(מאוזן|מאונך)")
+
+    fun inspect(
+        original: String,
+        expectedHorizontal: Map<Int, Int>,
+        expectedVertical: Map<Int, Int>,
+        recognizedLineCount: Int = 0
+    ): Audit {
+        // The legacy parser, not the audit, remains the only candidate authority.
+        val accepted = AdminLocalOcrLengthV213.extract(
+            original, expectedHorizontal, expectedVertical)
+        val text = original.replace(Regex("[\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]"), " ")
+            .replace(Regex("\\s+"), " ").trim()
+        val h = strictAcross.find(text)
+        val v = h?.let { strictDown.find(text, it.range.last + 1) }
+        val stats = Counters()
+        val states = linkedMapOf<AdminLocalOcrLengthV213.Key, String>()
+        for (number in expectedHorizontal.keys) {
+            states[AdminLocalOcrLengthV213.Key("across", number)] = "not-reached"
+        }
+        for (number in expectedVertical.keys) {
+            states[AdminLocalOcrLengthV213.Key("down", number)] = "not-reached"
+        }
+        if (h != null && v != null && v.range.first > h.range.last) {
+            scan(text.substring(h.range.last + 1, v.range.first), "across", expectedHorizontal, states, stats)
+            scan(text.substring(v.range.last + 1), "down", expectedVertical, states, stats)
+        }
+        val reason = when {
+            text.isBlank() -> "no-recognized-text"
+            h == null -> "missing-horizontal-heading"
+            v == null -> if (strictDown.containsMatchIn(text))
+                "missing-vertical-heading-after-horizontal" else "missing-vertical-heading"
+            v.range.first <= h.range.last -> "invalid-heading-order"
+            accepted.isNotEmpty() -> if (states.values.any { it == "unordered-or-duplicate-number-labels" ||
+                it == "multiple-tuples-ownership-unclear" || it == "tuple-grid-length-mismatch" })
+                "candidates-with-rejections" else "candidates-present"
+            stats.unorderedSections > 0 -> "unordered-or-duplicate-number-labels"
+            stats.acceptableLabels == 0 -> "no-recognized-grid-labels"
+            stats.ambiguousTuples > 0 -> "ambiguous-multiple-tuples"
+            stats.gridMismatch > 0 -> "tuple-grid-length-mismatch"
+            stats.tuples == 0 -> "no-multipart-tuple-in-numbered-clue"
+            else -> "no-safe-candidates"
+        }
+        val fallback = when {
+            h == null || v == null -> "section-header-unavailable"
+            else -> "label-not-seen"
+        }
+        val finalStates = states.mapValues { (key, value) ->
+            when {
+                key in accepted -> "accepted"
+                value == "not-reached" -> fallback
+                else -> value
+            }
+        }
+        val summary = listOf(
+            "lines=$recognizedLineCount", "chars=${text.length}",
+            "headingH=${if (h != null) 1 else 0}", "headingV=${if (v != null) 1 else 0}",
+            "bareH=${if (bareAcross.containsMatchIn(text)) 1 else 0}",
+            "bareV=${if (bareDown.containsMatchIn(text)) 1 else 0}",
+            "labelsH=${stats.horizontalLabels}", "labelsV=${stats.verticalLabels}",
+            "unordered=${stats.unorderedSections}", "singleTuples=${stats.tuples}",
+            "missingTuple=${stats.missingTuples}", "ambiguous=${stats.ambiguousTuples}",
+            "badGridSum=${stats.gridMismatch}", "accepted=${accepted.size}"
+        ).joinToString(";")
+        return Audit(accepted, reason, summary, finalStates)
+    }
+
+    private class Counters {
+        var horizontalLabels = 0
+        var verticalLabels = 0
+        var acceptableLabels = 0
+        var unorderedSections = 0
+        var tuples = 0
+        var missingTuples = 0
+        var ambiguousTuples = 0
+        var gridMismatch = 0
+    }
+
+    private fun scan(
+        section: String,
+        direction: String,
+        expected: Map<Int, Int>,
+        states: MutableMap<AdminLocalOcrLengthV213.Key, String>,
+        stats: Counters
+    ) {
+        // Mirror v213's exact number ownership/ordering gates for diagnostics.
+        val labels = marker.findAll(section).mapNotNull { m ->
+            val number = m.groupValues[1].toIntOrNull() ?: return@mapNotNull null
+            if (number !in expected) return@mapNotNull null
+            number to m
+        }.toList()
+        if (direction == "across") stats.horizontalLabels = labels.size
+        else stats.verticalLabels = labels.size
+        stats.acceptableLabels += labels.size
+        if (labels.map { it.first }.distinct().size != labels.size ||
+            labels.zipWithNext().any { (a, b) -> a.first >= b.first }) {
+            stats.unorderedSections++
+            for (number in expected.keys) {
+                states[AdminLocalOcrLengthV213.Key(direction, number)] = "unordered-or-duplicate-number-labels"
+            }
+            return
+        }
+        for ((index, labelled) in labels.withIndex()) {
+            val (number, m) = labelled
+            val end = labels.getOrNull(index + 1)?.second?.range?.first ?: section.length
+            val clue = section.substring(m.range.last + 1, end)
+            val matches = tuple.findAll(clue).toList()
+            val key = AdminLocalOcrLengthV213.Key(direction, number)
+            when {
+                matches.isEmpty() -> {
+                    stats.missingTuples++
+                    states[key] = "no-single-multipart-tuple"
+                }
+                matches.size > 1 -> {
+                    stats.ambiguousTuples++
+                    states[key] = "multiple-tuples-ownership-unclear"
+                }
+                else -> {
+                    stats.tuples++
+                    val parts = part.findAll(matches.single().groupValues[1]).map { it.value.toInt() }.toList()
+                    val hasReference = ("מאוזן" in clue || "מאונך" in clue) &&
+                        explicitReference.containsMatchIn(clue)
+                    val valid = parts.sum() == expected[number] ||
+                        (hasReference && parts.sum() > (expected[number] ?: 0))
+                    if (parts.size !in 2..6 || parts.any { it !in 1..99 } || !valid) {
+                        stats.gridMismatch++
+                        states[key] = "tuple-grid-length-mismatch"
+                    } else {
+                        // Only extract() can authorize a candidate; this is a
+                        // reason label, never an alternate parse result.
+                        states[key] = "structurally-eligible"
+                    }
+                }
+            }
+        }
+    }
+}
