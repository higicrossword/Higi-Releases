+    /** Phase 1 is an ALL-20 preflight; no AI is requested with a missing/changed image. */
+    private fun ensureSources():Int {
+        var ready=0
+        for((index,s) in sources.withIndex()){
+            if(stopping)break
+            update("הורדת מקורות ${index+1}/20: ${s.date}; אומתו: $ready")
+            if(validSource(s)){ready++;continue}
+            val dir=issueDir(s)
+            val target=File(dir,"source.jpg")
+            if(target.exists())target.delete()
+            val temp=ImageDownload.fetch(s.url,WeeklyCrosswordsFetcher.USER_AGENT,cacheDir)
+            try{
+                require(temp.length()==s.bytes && sha256(temp)==s.sha256){"Image changed or mismatch for ${s.date}; no AI will be called"}
+                val b=BitmapFactory.Options().apply{inJustDecodeBounds=true}
+                BitmapFactory.decodeFile(temp.absolutePath,b)
+                require(b.outWidth==s.width && b.outHeight==s.height){"Original pixel dimensions changed"}
+                writeAtomic(target,temp.readBytes())
+                require(validSource(s)){"Source copy verification failed"}
+                ready++
+            }finally{temp.delete()}
+        }
+        return ready
+    }
