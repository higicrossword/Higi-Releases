+    private fun saveZip():String {
+        check(Build.VERSION.SDK_INT>=Build.VERSION_CODES.Q)
+        val name="Higi_HAFUCH_AI_Text_20_${SimpleDateFormat("yyyyMMdd_HHmmss",Locale.US).format(Date())}.zip"
+        val resolver=contentResolver
+        val info=ContentValues().apply {
+            put(MediaStore.MediaColumns.DISPLAY_NAME,name)
+            put(MediaStore.MediaColumns.MIME_TYPE,"application/zip")
+            put(MediaStore.MediaColumns.RELATIVE_PATH,Environment.DIRECTORY_DOWNLOADS)
+            put(MediaStore.MediaColumns.IS_PENDING,1)
+        }
+        val uri=resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI,info)?:error("Cannot create Downloads archive")
+        try{
+            resolver.openOutputStream(uri)?.use{raw->ZipOutputStream(raw.buffered()).use{zip->
+                fun entry(name:String,bytes:ByteArray){
+                    zip.putNextEntry(ZipEntry(name));zip.write(bytes);zip.closeEntry()
+                }
+                val manifest=JSONObject().apply {
+                    put("schema","higi-hafuch-ai-20-admin-research-v1")
+                    put("seriesId",AdminHafuchAiBatchPolicy.SERIES_ID)
+                    put("sourceManifestAsOf","2026-11-16")
+                    put("expectedSources",20)
+                    put("createdAt",System.currentTimeMillis())
+                    put("coordinateFromAIRequested",false)
+                    put("firebaseWrites",0);put("canonicalWrites",0)
+                    put("results",JSONArray())
+                }
+                val report=manifest.getJSONArray("results")
+                val allClues=StringBuilder("\uFEFFdate,direction,number,verbatim_text,physical_status,model,image_sha256\n")
+                fun csvCell(value:String):String {
+                    // Keep Hebrew punctuation intact and disarm spreadsheet formulas.
+                    val safe=if(value.trimStart().startsWith('=') || value.trimStart().startsWith('+') ||
+                        value.trimStart().startsWith('-') || value.trimStart().startsWith('@')) "'"+value else value
+                    return "\""+safe.replace("\"","\"\"")+"\""
+                }
+                sources.forEach{source->
+                    val dir=issueDir(source)
+                    val result=JSONObject().apply {
+                        put("date",source.date);put("url",source.url)
+                        put("sourceSha256",source.sha256)
+                        put("sourceVerified",validSource(source))
+                        put("ocrSaved",File(dir,"local-ocr.json").isFile)
+                        put("aiSaved",isFinished(source))
+                        put("aiAttemptStarted",File(dir,"ai-attempt.json").exists())
+                    }
+                    report.put(result)
+                    if(isFinished(source)) {
+                        val data=JSONObject(File(dir,"transcription.json").readText())
+                        val values=data.getJSONArray("clues")
+                        for(i in 0 until values.length()){
+                            val clue=values.getJSONObject(i)
+                            allClues.append(listOf(source.date,clue.optString("direction"),
+                                clue.optInt("number",-1).toString(),clue.optString("text"),
+                                clue.optString("physicalStatus"),data.optString("model"),source.sha256)
+                                .joinToString(",",transform=::csvCell)).append('\n')
+                        }
+                    }
+                    (listOf("source.jpg","local-ocr.json","ocr-error.json","ai-attempt.json",
+                        "ai-error.json","transcription.json","clues.csv") +
+                        dir.listFiles().orEmpty().filter{it.name.matches(Regex("ai-attempt-prior-[0-9]+\\.json"))}.map{it.name})
+                        .forEach{fname->
+                        val file=File(dir,fname)
+                        if(file.isFile) {
+                            zip.putNextEntry(ZipEntry("${source.date}/$fname"))
+                            file.inputStream().buffered().use{it.copyTo(zip)}
+                            zip.closeEntry()
+                        }
+                    }
+                }
+                entry("all_20_ai_clues.csv",allClues.toString().toByteArray(Charsets.UTF_8))
+                entry("manifest.json",manifest.toString(2).toByteArray(Charsets.UTF_8))
+                entry("README.txt",("Higi administrator HAFUCH_DEKEL text-only research bundle\n"+
+                    "20 SHA-pinned original images, OCR text/word geometry, existing Gemini verbatim text.\n"+
+                    "No AI image coordinates, no publishing, no Canonical/Firebase writes.\n"+
+                    "Incomplete provider calls are never automatically replayed.\n").toByteArray(Charsets.UTF_8))
+            }} ?:error("Cannot open Downloads file")
+            check(resolver.update(uri,ContentValues().apply{put(MediaStore.MediaColumns.IS_PENDING,0)},null,null)>0)
+            return name
+        }catch(e:Exception){resolver.delete(uri,null,null);throw e}
+    }
+
+    override fun onDestroy() {
+        stopping=true;worker.shutdown()
+        window.clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        super.onDestroy()
+    }
+}
