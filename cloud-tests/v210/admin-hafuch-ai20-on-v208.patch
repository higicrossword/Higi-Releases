@@ -0,0 +1,39 @@
+package com.example.hebrewcrossword
+
+import android.graphics.Bitmap
+
+/** Frozen HAFUCH_DEKEL-only fallback pattern for DATA COLLECTION, not a forced grid. */
+internal object HafuchAdminSourceGridV1 {
+    private val rows=listOf(
+        ".....#.......",
+        ".#.#.#.#.#.#.",
+        ".......#.....",
+        ".#.#.#.#.###.",
+        "...#........#",
+        ".#.###.#.#.#.",
+        "......#......",
+        ".#.#.#.###.#.",
+        "#........#...",
+        ".###.#.#.#.#.",
+        ".....#.......",
+        ".#.#.#.#.#.#.",
+        ".......#....."
+    )
+    private fun template():Crossword = Crossword(13,13,
+        MutableList(13){y->MutableList(13){x->Cell(blocked=rows[y][x]=='#')}}
+    ).also{it.assignNumbers()}
+
+    /** Pixel-proven template candidate, never a blind assignment based on the series name. */
+    fun verifiedBounds(source:Bitmap):BoxF? {
+        val expected=template()
+        val found=GridDetector.locate(source,expected) ?: return null
+        val actual=found.result.crossword
+        if(actual.rows!=13 || actual.cols!=13 ||
+            actual.startNumbers(Direction.HORIZONTAL).size!=14 ||
+            actual.startNumbers(Direction.VERTICAL).size!=14)return null
+        if(!(0 until 13).all { y -> (0 until 13).all { x ->
+                actual.cell(y,x).blocked==expected.cell(y,x).blocked
+            } })return null
+        return found.bounds
+    }
+}
