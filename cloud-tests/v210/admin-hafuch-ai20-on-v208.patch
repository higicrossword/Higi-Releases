+++ b/app/src/main/java/com/example/hebrewcrossword/AdminHafuchAiBatchPolicy.kt
@@ -0,0 +1,47 @@
+package com.example.hebrewcrossword
+
+/** Isolated 20-source HAFUCH_DEKEL administrator batch. No other series or source is allowed. */
+internal object AdminHafuchAiBatchPolicy {
+    const val SERIES_ID = "HAFUCH_DEKEL"
+    const val EXPECTED = 20
+    const val SCHEMA = "higi-admin-hafuch-20-sources-v1"
+    data class Source(
+        val date:String, val title:String, val url:String, val thread:String,
+        val sha256:String, val width:Int, val height:Int, val bytes:Long
+    )
+    private val datePattern=Regex("^20[0-9]{2}-[0-9]{2}-[0-9]{2}$")
+    private val digestPattern=Regex("^[a-f0-9]{64}$")
+
+    fun validate(sources:List<Source>):List<Source> {
+        require(sources.size==EXPECTED) { "Expected exactly 20 unique originals, not ${sources.size}" }
+        require(sources.map{it.date}.toSet().size==EXPECTED) { "Duplicate source date" }
+        require(sources.map{it.sha256}.toSet().size==EXPECTED) { "Duplicate source image" }
+        val days=mutableListOf<Long>()
+        sources.forEach { row ->
+            require(datePattern.matches(row.date) && row.sha256.matches(digestPattern)) { "Invalid source identity" }
+            val format=java.text.SimpleDateFormat("yyyy-MM-dd",java.util.Locale.US).apply {
+                isLenient=false;timeZone=java.util.TimeZone.getTimeZone("UTC")
+            }
+            days+=(requireNotNull(format.parse(row.date)).time/86_400_000L)
+            require(row.title.contains("הפוך על הפוך")) { "Wrong crossword series" }
+            require(row.url.startsWith("https://groups.google.com/group/tartey_mashma/attach/")) {
+                "Untrusted publisher image URL"
+            }
+            require(row.thread.startsWith("https://groups.google.com/g/tartey_mashma/c/")) {
+                "Untrusted source thread"
+            }
+            require(row.width in 300..8000 && row.height in 300..8000 && row.bytes in 10_000L..10_000_000L) {
+                "Unreasonable original source image size"
+            }
+        }
+        require(days.zipWithNext().all { (newer,older) -> newer-older==7L }) { "Not 20 consecutive weekly originals" }
+        return sources
+    }
+
+    /** No silent re-billing when an earlier invocation is incomplete or the app was killed. */
+    fun shouldCallAi(complete:Boolean, attemptRecorded:Boolean, explicitRetry:Boolean=false):Boolean =
+        !complete && (!attemptRecorded || explicitRetry)
+
+    /** A public crop/canonical publishing path MUST NOT be called from this batch. */
+    const val REVIEW_ONLY = true
+}
