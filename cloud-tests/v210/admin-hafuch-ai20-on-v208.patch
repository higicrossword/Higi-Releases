+    private fun boxJson(rect:CropRect,roiX:Int,roiY:Int,scale:Float):JSONArray {
+        fun x(v:Int)=(roiX+v/scale).toInt()
+        fun y(v:Int)=(roiY+v/scale).toInt()
+        return JSONArray(listOf(x(rect.left),y(rect.top),x(rect.right),y(rect.bottom)))
+    }
+    /** One Tesseract OCR on the original 97.5%-height region, NEVER extend the OCR ROI. */
+    private fun saveOnePassOcr(s:AdminHafuchAiBatchPolicy.Source,image:Bitmap,dir:File){
+        val bounds=HafuchAdminSourceGridV1.verifiedBounds(image)
+        if(bounds==null){
+            writeJson(File(dir,"local-ocr.json"),JSONObject().apply {
+                put("imageSha256",s.sha256);put("grid","UNVERIFIED")
+                put("status","GRID_NOT_PIXEL_PROVEN");put("words",JSONArray());put("lines",JSONArray())
+            })
+            return
+        }
+        val left=(bounds.right+image.width*.003f).toInt().coerceIn(0,image.width-24)
+        val top=(image.height*.035f).toInt().coerceIn(0,image.height-24)
+        val bottom=(image.height*.975f).toInt().coerceIn(top+24,image.height)
+        val region=Bitmap.createBitmap(image,left,top,image.width-left-2,bottom-top)
+        try{
+            val scale=minOf(1f,950f/region.width,1250f/region.height)
+            val w=(region.width*scale).toInt().coerceAtLeast(24)
+            val h=(region.height*scale).toInt().coerceAtLeast(24)
+            val prepared=Bitmap.createScaledBitmap(region,w,h,true)
+            try {
+                val words=mutableListOf<OcrSharedRowSplitterV161.Word>()
+                val lines=LocalHebrewOcrV031(this).use{it.readFullPageLines(prepared,wordBoxes=words)}
+                val wordArray=JSONArray()
+                words.forEach{v->wordArray.put(JSONObject().apply {
+                    put("text",v.text);put("confidence",v.confidence)
+                    put("sourceBox",boxJson(v.box,left,top,scale))
+                })}
+                val lineArray=JSONArray()
+                lines.forEach{v->lineArray.put(JSONObject().apply {
+                    put("text",v.text);put("confidence",v.confidence)
+                    put("sourceBox",boxJson(v.box,left,top,scale))
+                })}
+                writeJson(File(dir,"local-ocr.json"),JSONObject().apply{
+                    put("seriesId",AdminHafuchAiBatchPolicy.SERIES_ID)
+                    put("imageSha256",s.sha256);put("grid","PIXEL_VERIFIED_13x13")
+                    put("gridBounds",JSONArray(listOf(bounds.left,bounds.top,bounds.right,bounds.bottom)))
+                    put("roi",JSONArray(listOf(left,top,image.width-2,bottom)))
+                    put("scale",scale);put("ocrRuns",1)
+                    put("words",wordArray);put("lines",lineArray)
+                    put("note","Original source-pixel bounds; independent of Gemini text; review-only")
+                })
+            }finally{if(prepared!==region)prepared.recycle()}
+        }finally{region.recycle()}
+    }
