+package com.example.hebrewcrossword
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+
+class AdminHafuchAiBatchPolicyTest {
+    private fun twenty():List<AdminHafuchAiBatchPolicy.Source> {
+        val clock=Calendar.getInstance(TimeZone.getTimeZone("UTC"),Locale.US).apply{
+            set(2026,Calendar.NOVEMBER,13,0,0,0);set(Calendar.MILLISECOND,0)
+        }
+        val format=SimpleDateFormat("yyyy-MM-dd",Locale.US).apply{timeZone=TimeZone.getTimeZone("UTC")}
+        return (0 until 20).map { i ->
+            val date=format.format(clock.time)
+            clock.add(Calendar.DATE,-7)
+            AdminHafuchAiBatchPolicy.Source(date,"הפוך על הפוך דקל בנו $date",
+                "https://groups.google.com/group/tartey_mashma/attach/$i/issue.jpg",
+                "https://groups.google.com/g/tartey_mashma/c/$i",
+                i.toString(16).padStart(64,'0'),2048,1600,100000)
+        }
+    }
+    @Test fun acceptsExactlyTwentyWeeklyDifferentImages(){
+        val originals=twenty()
+        assertEquals(20,AdminHafuchAiBatchPolicy.validate(originals).size)
+    }
+    @Test fun rejectsMissingDuplicateWrongSeriesOrURL(){
+        val originals=twenty()
+        val wrongs=listOf(originals.drop(1),
+            originals.toMutableList().apply{this[2]=this[1]},
+            originals.toMutableList().apply{this[6]=this[6].copy(title="דקל בנו שני")},
+            originals.toMutableList().apply{this[8]=this[8].copy(url="https://evil.example/puzzle.jpg")},
+            originals.toMutableList().apply{this[10]=this[10].copy(date="2026-01-03")})
+        wrongs.forEach { rows ->
+            try { AdminHafuchAiBatchPolicy.validate(rows);fail("Expected rejection") }
+            catch (_:IllegalArgumentException){}
+        }
+    }
+    @Test fun neverRepeatsCompletedOrAmbiguousAiAttempts(){
+        assertTrue(AdminHafuchAiBatchPolicy.shouldCallAi(false,false))
+        assertFalse(AdminHafuchAiBatchPolicy.shouldCallAi(true,true))
+        assertFalse(AdminHafuchAiBatchPolicy.shouldCallAi(false,true))
+        assertTrue(AdminHafuchAiBatchPolicy.shouldCallAi(false,true,explicitRetry=true))
+        assertTrue(AdminHafuchAiBatchPolicy.REVIEW_ONLY)
+        assertEquals("HAFUCH_DEKEL",AdminHafuchAiBatchPolicy.SERIES_ID)
+    }
+}
