+    private fun collect(allowAmbiguousRetry:Boolean):String {
+        val downloaded=ensureSources()
+        if(downloaded!=20)return "אומתו $downloaded/20 תמונות. ${if(stopping)"נעצר לפי בקשה" else "שגיאה בהורדת המקורות"}. לא בוצעו קריאות AI."
+        var successes=0;var attempted=0;var ambiguous=0;var ocrFailed=0
+        for((index,s) in sources.withIndex()){
+            if(stopping)break
+            update("מעבד ${index+1}/20: ${s.date}; פוענחו: $successes; בקשות AI חדשות: $attempted")
+            val dir=issueDir(s)
+            val aiComplete=isFinished(s)
+            val ambiguousAttempt=File(dir,"ai-attempt.json").exists() && !aiComplete
+            val needsOcr=!File(dir,"local-ocr.json").isFile
+            if(aiComplete && !needsOcr){successes++;continue}
+            val sourceFile=File(dir,"source.jpg")
+            val bitmap=BitmapFactory.decodeFile(sourceFile.absolutePath)
+                ?:throw IllegalStateException("Could not decode verified source ${s.date}")
+            try{
+                if(needsOcr){
+                    val result=runCatching{saveOnePassOcr(s,bitmap,dir)}
+                    result.onFailure{e->
+                        ocrFailed++
+                        writeJson(File(dir,"ocr-error.json"),JSONObject().apply{
+                            put("imageSha256",s.sha256);put("error",e.javaClass.simpleName)
+                            put("message",DebugLog.sanitize(e.message.orEmpty()).take(200))
+                        })
+                    }
+                }
+                if(aiComplete){successes++;continue}
+                if(ambiguousAttempt && !allowAmbiguousRetry){ambiguous++;continue}
+                if(stopping)break
+                // Preserve the earlier attempt record before a deliberate retry.
+                if(ambiguousAttempt){
+                    val prior=File(dir,"ai-attempt.json")
+                    val previous=File(dir,"ai-attempt-prior-${System.currentTimeMillis()}.json")
+                    check(prior.copyTo(previous,overwrite=false).isFile)
+                }
+                // Persist BEFORE provider invocation: if process dies, no hidden second billable call.
+                writeJson(File(dir,"ai-attempt.json"),JSONObject().apply{
+                    put("seriesId",AdminHafuchAiBatchPolicy.SERIES_ID)
+                    put("imageSha256",s.sha256);put("startedAt",System.currentTimeMillis())
+                    put("model",GeminiSmartOcr.PRIMARY_MODEL);put("requestType","verbatim_text_only_no_coordinates")
+                })
+                attempted++
+                update("קריאת AI $attempted (תשבץ ${index+1}/20): ${s.date} — תמלול טקסט בלבד")
+                val decoded=runCatching{runBlocking{
+                    GeminiSmartOcr().transcribeCluesVerbatimForAdmin(bitmap,GeminiSmartOcr.PRIMARY_MODEL)
+                }}
+                decoded.onSuccess{outcome->
+                    val clues=JSONArray()
+                    for(clue in outcome.clues){
+                        clues.put(JSONObject().apply{
+                            put("direction",clue.direction);put("number",clue.number)
+                            put("text",clue.exactText)
+                            put("numbersLeftToRight",clue.physicalNumbersLeftToRight?.let{JSONArray(it)}?:JSONObject.NULL)
+                            put("physicalStatus",clue.physicalStatus)
+                        })
+                    }
+                    check(clues.length()>0)
+                    val meta=JSONObject().apply {
+                        put("seriesId",AdminHafuchAiBatchPolicy.SERIES_ID);put("date",s.date)
+                        put("imageSha256",s.sha256);put("model",outcome.model)
+                        put("elapsedMs",outcome.elapsedMs);put("sourceUrl",s.url)
+                        put("geometryRequested",false);put("aiCallsRequested",1)
+                        put("clues",clues);put("rawResponse",JSONObject(outcome.responseJson))
+                        put("promptTokens",outcome.usage?.promptTokens ?: JSONObject.NULL)
+                        put("candidateTokens",outcome.usage?.candidateTokens ?: JSONObject.NULL)
+                        put("thoughtsTokens",outcome.usage?.thoughtsTokens ?: JSONObject.NULL)
+                        put("totalTokens",outcome.usage?.totalTokens ?: JSONObject.NULL)
+                    }
+                    writeJson(File(dir,"transcription.json"),meta)
+                    val run=AdminVerbatimTranscriptionFormat.Run(outcome.model,outcome.model,outcome.clues,
+                        outcome.elapsedMs,outcome.usage?.promptTokens,outcome.usage?.candidateTokens,
+                        outcome.usage?.thoughtsTokens,outcome.usage?.totalTokens)
+                    writeAtomic(File(dir,"clues.csv"),AdminVerbatimTranscriptionFormat.csv(listOf(run)).toByteArray(Charsets.UTF_8))
+                    successes++
+                }.onFailure{e->
+                    val reason=DebugLog.sanitize(e.message.orEmpty()).ifBlank{e.javaClass.simpleName}
+                    writeJson(File(dir,"ai-error.json"),JSONObject().apply{
+                        put("imageSha256",s.sha256);put("error",e.javaClass.simpleName)
+                        put("message",reason.take(200));put("at",System.currentTimeMillis())
+                    })
+                }
+            }finally{bitmap.recycle()}
+        }
+        val exported=runCatching{saveZip()}
+        return "מקורות מאומתים: $downloaded/20\nתמלולים שמורים: $successes/20\n"+
+            "קריאות AI חדשות: $attempted\nבקשות ישנות שלא יבוצעו שוב אוטומטית: $ambiguous\n"+
+            "שגיאות OCR: $ocrFailed\n"+exported.fold({"נשמר ב־Downloads: $it"},{"שמירה ל־Downloads נכשלה: ${it.message.orEmpty()}; הנתונים נשארו פרטיים במכשיר"})
+    }
