+    private fun sha256(file:File):String {
+        val digest=MessageDigest.getInstance("SHA-256")
+        file.inputStream().buffered().use{input->
+            val buf=ByteArray(32768)
+            while(true){val n=input.read(buf);if(n<0)break;digest.update(buf,0,n)}
+        }
+        return digest.digest().joinToString(""){ "%02x".format(it.toInt() and 255) }
+    }
+    private fun writeAtomic(path:File,bytes:ByteArray){
+        val tmp=File(path.parentFile,"${path.name}.${UUID.randomUUID()}.tmp")
+        try {
+            FileOutputStream(tmp).use{out->out.write(bytes);out.fd.sync()}
+            if(!tmp.renameTo(path)){tmp.copyTo(path,overwrite=true);check(tmp.delete())}
+        }finally{tmp.delete()}
+    }
+    private fun writeJson(path:File,root:JSONObject)=writeAtomic(path,root.toString(2).toByteArray(Charsets.UTF_8))
+    private fun validSource(source:AdminHafuchAiBatchPolicy.Source):Boolean {
+        val file=File(issueDir(source),"source.jpg")
+        return file.isFile && file.length()==source.bytes && sha256(file)==source.sha256
+    }
+    private fun isFinished(s:AdminHafuchAiBatchPolicy.Source):Boolean = runCatching{
+        val f=File(issueDir(s),"transcription.json")
+        val j=JSONObject(f.readText())
+        f.isFile && validSource(s) && j.optString("imageSha256")==s.sha256 &&
+            j.optString("seriesId")==AdminHafuchAiBatchPolicy.SERIES_ID &&
+            j.getJSONArray("clues").length()>0
+    }.getOrDefault(false)
