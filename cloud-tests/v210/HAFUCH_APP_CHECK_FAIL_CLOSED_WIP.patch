index 0fa5076..20316ed 100644
--- a/app/src/main/java/com/example/hebrewcrossword/AdminHafuchAiBatchPolicy.kt
+++ b/app/src/main/java/com/example/hebrewcrossword/AdminHafuchAiBatchPolicy.kt
@@ -42,6 +42,16 @@ internal object AdminHafuchAiBatchPolicy {
     fun shouldCallAi(complete:Boolean, attemptRecorded:Boolean, explicitRetry:Boolean=false):Boolean =
         !complete && (!attemptRecorded || explicitRetry)
 
+    /** Fail closed on server-side App Check rejection, without retrying any billable AI call. */
+    fun isAppCheckRejection(error:Throwable?):Boolean =
+        generateSequence(error){it.cause}.take(8).any { throwable ->
+            val message=throwable.message.orEmpty().lowercase(java.util.Locale.ROOT)
+            (message.contains("app check") || message.contains("appcheck") ||
+                message.contains("attestation")) &&
+                (message.contains("invalid") || message.contains("denied") ||
+                    message.contains("unauthorized") || message.contains("403"))
+        }
+
     /** A public crop/canonical publishing path MUST NOT be called from this batch. */
     const val REVIEW_ONLY = true
 }
